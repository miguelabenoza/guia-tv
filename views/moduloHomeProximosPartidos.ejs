


<% if (fixtures.length > 0) { %>
<div class="container-news">
  <h1 class="main-title">🎯 Próximos partidos</h1>
</div>
<div class="flex">
  
  <ul class="container-matches">
    <!-- Último partido -->
     <% if (fixtures_last_match.length > 0) { %>
        <% fixtures_last_match.forEach(match => { %>

          <li>
              <div class="card-team-match-finished">
                <div class="match-teams">
                  <div class="team-left">
                      <img class="img-team" src="<%= match.teams.home.logo %>" alt="<%= match.teams.home.name %>">
                      <% if (match.teams.home.winner == true) { %>
                        <p class="match-result match-wins"><%= match.goals.home %></p>
                      <% } else if (match.teams.home.winner == false) { %>
                        <p class="match-result"><%= match.goals.home %></p>
                      <% } %>
                  </div>

                  <div class="match-separator">
                      <p> - </p>
                  </div>

                  <div class="team-right">
                      <% if (match.teams.away.winner == true) { %>
                        <p class="match-result match-wins"><%= match.goals.away %></p>
                      <% } else if (match.teams.away.winner == false) { %>
                        <p class="match-result"><%= match.goals.away %></p>
                      <% } %>
                      <img class="img-team" src="<%= match.teams.away.logo %>" alt="<%= match.teams.away.name %>">
                  </div>
                </div>
              </div>
          </li>

        <% }) %>
      <% } %>

    <!-- Próximoso partidos -->
      <% fixtures.forEach(match => { 
          const fecha = new Date(match.fixture.date); 
      %>
        <li>
            <div class="card-team-match">
                <div class="match-teams">
                  <div class="team-left">
                      <img class="img-team" src="<%= match.teams.home.logo %>" alt="<%= match.teams.home.name %>">
                  </div>

                  <div class="team-right">
                      <img class="img-team" src="<%= match.teams.away.logo %>" alt="<%= match.teams.away.name %>">
                  </div>
                </div>

                <div class="match-date-info">
                  <p class="match-date">
                    <%= fecha.toLocaleDateString("es-ES", { 
                          weekday: "short" 
                    }) %>
                  </p>
                  <p>
                    <%= fecha.toLocaleDateString("es-ES", { 
                          day: "2-digit", 
                          month: "2-digit"
                    }) %>
                  </p>
                </div>
                
                <div class="match-date-hour">
                  <p class="match-hour">
                    <%= fecha.toLocaleTimeString("es-ES", { 
                          hour: "2-digit", 
                          minute: "2-digit",
                          timeZone: "Europe/Madrid"
                    }) %>
                  </p>
                </div>
                  
            </div>
        </li>
      <% }) %>

    </div>
</ul>
<% } %>