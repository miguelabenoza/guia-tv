
<div class="container-news">
    <div class="flex">
        <img class="news-card-footer-logo" src="/logos/barcelona.png" alt="FC Barcelona">
        <h1 class="main-title ml">FC Barcelona</h1>
    </div>

    <div class="grid-container">
        <% if (noticiasBarcelona.length > 0) { %>
            <% noticiasBarcelona.forEach(noticia => { %>
                <a href="/noticia/<%= noticia._id %>">
                    <article class="grid-news-card">
                        <div class="news-card-title">
                            <p><%= noticia.titulo %></p>
                            <div class="news-card-footer">
                                <div class="news-card-footer-info">
                                    <div>
                                        <img class="news-card-footer-logo" src="<%= noticia.logo %>" alt="">
                                    </div>
                                    <p class="news-card-footer-medio"><%= noticia.medio %></p>
                                </div>
                                <p class="news-card-footer-time"><%= noticia.hace %></p>
                            </div>
                        </div>

                        <picture class="news-card-image">
                            <img class="img" src="<%= noticia.img %>" alt="<%= noticia.medio %>">
                        </picture>
                    </article>
                </a>
                <% }) %>
            <% } else { %>
                <p>No hay noticias disponibles.</p>
        <% } %>
    </div>
</div>