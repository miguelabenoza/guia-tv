<%- include('header.ejs') %>

<div class="container">
  <p class="main-title">Últimas noticias</p>

  <% if (noticias.length > 0) { %>
    <% noticias.forEach(noticia => { %>
    <a href="/noticia/<%= noticia._id %>">
      <div class="card-news">
        <img class="card-img" src="<%= noticia.img %>" alt="<%= noticia.medio %>">

        <div class="card-news-info">
            <div class="card-title">
                <p class=""><%= noticia.titulo %></p>
            </div>

            <div class="medium-info">
                <div class="medium-name">
                    <img class="medium-logo" src="<%= noticia.logo %>" alt="">
                    <p class="medium-name"> <%= noticia.medio %> </p>
                </div>
                <div>
                    <p class="medium-hour"><%= noticia.hace %></p>
                </div>
            </div>
        </div>
      </div>
    </a>
    <% }) %>
    <% } else { %>
        <p>No hay noticias disponibles.</p>
  <% } %>
</div>



<%- include('footer.ejs') %> 