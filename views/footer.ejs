
<script>
    function mostrarFechaActual() {
      const hoy = new Date();

      const opciones = {
        weekday: 'long',  // nombre del día
        year: 'numeric',  // año completo
        month: 'long',    // mes en letras
        day: 'numeric'    // número del día
      };

      const fechaModificada = hoy.toLocaleDateString('es-ES', opciones);

      // Insertar en el <p>
      document.getElementById("fecha").textContent = fechaModificada;
    }

    // Llamar a la función al cargar la página
    mostrarFechaActual();
  </script>
</body>
</html> 