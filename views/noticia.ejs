<%- include('header.ejs') %>

<div class="article-container">
    <h1 class="main-title"><%= noticia.titulo %></h1>
    <h4 class="noticia-sub-title"><%= noticia.subtitulo %></h4>

    <img class="noticia-img"  src="<%= noticia.img %>" alt="<%= noticia.titulo %>">
    
    <div class="noticia-info">
      <img class="medium-logo" src="<%= noticia.logo %>" alt="<%= noticia.medio %>">
      <div class="medium-detail">
        <p><%= noticia.medio %></p>
        <div class="noticia-fecha">
          <p><%= noticia.fechaHora.toLocaleString("es-ES", { 
            // weekday: "long",
            year: "numeric",
            month: "long",
            day: "numeric",
          }) %></p>
        </div>
      </div>
    </div>
    <article class="main-article"><%- noticia.contenido_html %></article>
</div>



<%- include('footer.ejs') %> 