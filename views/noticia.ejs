<%- include('header.ejs') %>
<div class="news-container">
  <div class="menu">
    <a href="/">
      <div class="arrow">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 16 16"><path fill="#000000" d="M7.78 12.53a.75.75 0 0 1-1.06 0L2.47 8.28a.75.75 0 0 1 0-1.06l4.25-4.25a.751.751 0 0 1 1.042.018a.751.751 0 0 1 .018 1.042L4.81 7h7.44a.75.75 0 0 1 0 1.5H4.81l2.97 2.97a.75.75 0 0 1 0 1.06Z"/></svg>
      </div>
    </a>
  </div>
  <div class="article-container">
      <h1 class="main-title"><%= noticia.titulo %></h1>
      <div class="medio-info">
        <img class="medio-icon" src="<%= noticia.logo %>" alt="<%= noticia.medio %>">
        <div class="medium-detail">
          <p><%= noticia.medio %></p>
          <div class="noticia-fecha">
            <p><%= noticia.fechaHora.toLocaleString("es-ES", { 
              // weekday: "long",
              // year: "numeric",
              weekday: "short",
              day: "numeric",
              hour: "2-digit",
              minute:"2-digit"
            }) %></p>
          </div>
        </div>
      </div>
  </div>
    

  <div>
    <% if (noticia.video && noticia.video.trim() !== "") { %>
      <video type="video/mp4" src="<%= noticia.video %>" controls poster="<%= noticia.img %>"></video>
      <h4 class="article-container noticia-sub-title"><%= noticia.subtitulo %></h4>
      <article class="main-article"><%- noticia.contenido_html %></article>
    <% } else { %>
      <img class="noticia-img"  src="<%= noticia.img %>" alt="<%= noticia.titulo %>">
      <article class="main-article"><%- noticia.contenido_html %></article>
    <% } %>
  </div>

</div>



<%- include('footer.ejs') %> 