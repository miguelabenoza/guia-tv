                                    <span class="text-sm ml-2 md:ml-2"><%= noticia.medio %></span>
                                    <span class="text-sm ml-1 md:ml-1">·</span>
                                    <span class="text-sm ml-1 md:ml-1 text-gray-400"><%= noticia.hace %></span>
