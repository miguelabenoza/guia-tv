<%- include('header.ejs') %>

<div class="grid lg:grid-cols-12 lg:p-8 lg:gap-6 max-w-3xl m-auto ">
    <div class="hidden col-span-12">
        <a href="/">
        <div class="inline-flex hover:cursor-pointer border border-amber-600">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 16 16"><path fill="#000000" d="M7.78 12.53a.75.75 0 0 1-1.06 0L2.47 8.28a.75.75 0 0 1 0-1.06l4.25-4.25a.751.751 0 0 1 1.042.018a.751.751 0 0 1 .018 1.042L4.81 7h7.44a.75.75 0 0 1 0 1.5H4.81l2.97 2.97a.75.75 0 0 1 0 1.06Z"/></svg>
        </div>
        </a>
    </div>
    <div class="mt-4 pl-5 pr-5 md:pl-0 md:pr-0 col-span-12">
        <h1 class="font-bold text-2xl mb-5"><%= noticia.titulo %></h1>
        <div class="flex items-center mb-5 lg:mb-0">
            <img class="w-8 h-8" src="<%= noticia.logo %>" alt="<%= noticia.medio %>">
            <div class="text-sm ml-2">
                <p><%= noticia.medio %></p>
                <div class="text-sm">
                    <p><%= noticia.fechaHora.toLocaleString("es-ES", { 
                    // weekday: "long",
                    // year: "numeric",
                    weekday: "short",
                    day: "numeric",
                    hour: "2-digit",
                    minute:"2-digit"
                    }) %></p>
                </div>
            </div>
        </div>
    </div>
        

    <div class="col-span-12">
        <% if (noticia.video && noticia.video.trim() !== "") { %>
        <video class="w-full mb-4" type="video/mp4" src="<%= noticia.video %>" controls poster="<%= noticia.img %>"></video>
        <article class="mb-4 pl-5 pr-5 md:pl-0 md:pr-0"><%= noticia.subtitulo %></article>
        <article class="pl-5 pr-5 md:pl-0 md:pr-0"><%- noticia.contenido_html %></article>
        <% } else { %>
        <img class="w-full object-cover md:rounded-lg mb-4 place-items-center"  src="<%= noticia.img %>" alt="<%= noticia.titulo %>">
        <article class="mb-4 pl-5 pr-5 md:pl-0 md:pr-0"><%- noticia.contenido_html %></article>
        <% } %>
    </div>

</div>



<%- include('footer.ejs') %> 